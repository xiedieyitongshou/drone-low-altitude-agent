.git
.idea
.venv
__pycache__
*.pyc

# Runtime configuration and secrets must be injected at deploy time.
.env
.env.*
*.pem
*.key
*.crt
*.csr

# Runtime data must stay outside image layers.
*.db
*.sqlite
data/drone_agent.db
data/backups
data/samples
data/knowledge/index
evals/reports

# Documentation is not needed by the runtime image and may include
# non-ASCII filenames that older Docker BuildKit versions reject.
*.md
docs
