# Copy this file to .env on the server before running docker compose.
# This file is safe to commit because all secrets and public endpoints are placeholders.

# Application
APP_NAME=drone-low-altitude-agent
APP_ENV=production-demo
APP_PORT=8000
LOG_LEVEL=INFO

# Public frontend build settings
# Use an HTTPS domain after domain/ICP/SSL are ready.
# Short-term IP demo example: http://<server-public-ip>:8000
VITE_API_BASE_URL=https://<your-demo-domain>/api
VITE_API_TIMEOUT_MS=60000

# Backend CORS
# Use the exact frontend origin. Examples:
# CORS_ALLOWED_ORIGINS=https://<your-demo-domain>
# CORS_ALLOWED_ORIGINS=http://<server-public-ip>:5173
CORS_ALLOWED_ORIGINS=https://<your-demo-domain>

# Weather API
QWEATHER_API_KEY=<replace-with-qweather-api-key>
QWEATHER_GEO_BASE_URL=https://<your-qweather-geo-host>
QWEATHER_WEATHER_BASE_URL=https://<your-qweather-weather-host>
QWEATHER_WARNING_BASE_URL=https://<your-qweather-warning-host>
QWEATHER_TIMEOUT_SECONDS=10
QWEATHER_MAX_RETRIES=3
QWEATHER_RETRY_BACKOFF_SECONDS=1
QWEATHER_LANG=zh

# Storage
# PostgreSQL runs in Docker Compose and persists data in the postgres_data Docker volume.
DATABASE_URL=postgresql+psycopg://drone_agent:<replace-with-postgres-password>@postgres:5432/drone_agent
POSTGRES_DB=drone_agent
POSTGRES_USER=drone_agent
POSTGRES_PASSWORD=<replace-with-postgres-password>

# Auth and admin bootstrap
JWT_SECRET_KEY=<replace-with-long-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_DEMO_MODE=false
INITIAL_ADMIN_USERNAME=<replace-with-admin-username>
INITIAL_ADMIN_PASSWORD=<replace-with-strong-admin-password>

# Session memory
SESSION_MEMORY_BACKEND=redis
REDIS_URL=redis://redis:6379/0
SESSION_MEMORY_TTL_SECONDS=1800
SESSION_MEMORY_MAXSIZE=1024
SESSION_MEMORY_REDIS_KEY_PREFIX=drone_agent:session:

# LLM explanation and natural language parser
# Keep disabled for the first public deployment, then enable after keys and cost controls are verified.
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=
LLM_API_KEY=
DEEPSEEK_API_KEY=<replace-with-deepseek-api-key-or-leave-empty>
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=600
NL_PARSER_MODE=rule

# Agent Runtime, Trace, Guardrail
AGENT_RUNTIME_MODE=loop
AGENT_LOG_RAW_PAYLOAD=false

# RAG retriever and confidence controls
ADVICE_KNOWLEDGE_PATH=data/knowledge/advice_rules.json
# Leave empty to let the retriever prefer generated DB knowledge indexes when present.
KNOWLEDGE_SOURCE_PATH=
KNOWLEDGE_RETRIEVER=bm25
KNOWLEDGE_EMBEDDING_MIN_SCORE=0.25
RAG_CONFIDENCE_THRESHOLD=0.2

# Optional DeepSeek enablement after deployment is stable:
# LLM_ENABLED=true
# NL_PARSER_MODE=hybrid
